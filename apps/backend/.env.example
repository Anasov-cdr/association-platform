# Server
PORT=4000
NODE_ENV="development"

# Frontend
CLIENT_ORIGIN=http://localhost:5173

# Database
DATABASE_URL="postgresql://alumni_user:alumni_password@localhost:5432/alumni_db?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# File Upload (S3 or Supabase)
# S3
S3_BUCKET_NAME="alumni-storage"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Supabase (alternative)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Email
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@alumni.org"

# Socket.io
SOCKET_CORS_ORIGIN="http://localhost:5173"
