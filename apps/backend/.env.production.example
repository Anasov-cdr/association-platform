# Server
PORT=4000
NODE_ENV=production
CLIENT_ORIGIN=https://bfetassociation.kg

# Database used by docker-compose.prod.yml
POSTGRES_USER=alumni_user
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=alumni_db
DATABASE_URL=postgresql://alumni_user:replace-with-strong-db-password@postgres:5432/alumni_db?schema=public

# JWT: generate with `openssl rand -hex 64`
JWT_ACCESS_SECRET=replace-with-strong-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mailbox@bfetassociation.kg
SMTP_PASSWORD=replace-with-smtp-app-password
SMTP_FROM=Ассоциация выпускников БФЭТ <noreply@bfetassociation.kg>
